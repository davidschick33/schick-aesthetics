# Hostinger / Apache / LiteSpeed:
# Die fertige Website liegt im Ordner docs/. Diese Regeln liefern sie unter
# der Hauptadresse aus (www.schick-aesthetik.de/leistungen/ -> docs/leistungen/),
# ohne dass "docs" in der Adresse erscheint. Quellcode-Dateien (build.py usw.)
# sind dadurch von außen nicht erreichbar.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /docs/404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Direkte Aufrufe von /docs/... auf die saubere Adresse umleiten
RewriteCond %{THE_REQUEST} \s/docs/([^\s?]*) [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Ordner ohne abschließenden Schrägstrich -> mit Schrägstrich (/preise -> /preise/)
RewriteCond %{REQUEST_URI} !^/docs/
RewriteCond %{DOCUMENT_ROOT}/docs/$1 -d
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

# Alles intern aus docs/ ausliefern
RewriteCond %{REQUEST_URI} !^/docs/
RewriteRule ^(.*)$ docs/$1 [L]
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/manifest+json .webmanifest
