# Hostinger / Apache / LiteSpeed:
# Die fertige Website liegt im Ordner docs/. Diese Regeln liefern sie unter
# der Hauptadresse aus (www.schick-aesthetics.com/leistungen/ -> docs/leistungen/),
# ohne dass "docs" in der Adresse erscheint. Quellcode-Dateien (build.py usw.)
# sind dadurch von außen nicht erreichbar.

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /docs/404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Adresse ohne "www" dauerhaft auf https://www.schick-aesthetics.com umleiten (eine Adresse für Google)
RewriteCond %{HTTP_HOST} ^schick-aesthetics\.com$ [NC]
RewriteRule ^(.*)$ https://www.schick-aesthetics.com/$1 [R=301,L]

# Alte Adresse -> neue Leistungsseite
RewriteRule ^leistungen/vampirlifting-prp/?$ /leistungen/homoeopathische-eigenbluttherapie/ [R=301,L]

# Direkte Aufrufe von /docs/... auf die saubere Adresse umleiten
RewriteCond %{THE_REQUEST} \s/docs/([^\s?]*) [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Ordner ohne abschließenden Schrägstrich -> mit Schrägstrich (/preise -> /preise/)
RewriteCond %{REQUEST_URI} !^/docs/
RewriteCond %{DOCUMENT_ROOT}/docs/$1 -d
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

# Alles intern aus docs/ ausliefern
RewriteCond %{REQUEST_URI} !^/docs/
RewriteRule ^(.*)$ docs/$1 [L]
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/manifest+json .webmanifest
