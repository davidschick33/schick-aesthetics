# Hostinger / Apache / LiteSpeed:
# Die fertige Website liegt im Ordner docs/. Diese Regeln liefern sie unter
# der Hauptadresse aus (www.schick-aesthetics.com/leistungen/ -> docs/leistungen/),
# ohne dass "docs" in der Adresse erscheint. Quellcode-Dateien (build.py usw.)
# sind dadurch von außen nicht erreichbar.

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /docs/404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Jede Umleitung führt in EINEM Schritt direkt zur endgültigen Adresse
# (https + www + Schrägstrich), damit Google keine Umleitungsketten sieht.

# SSL-Zertifikat (Let's Encrypt) nie umleiten
RewriteRule ^\.well-known/ - [L]

# Alte Adresse -> neue Leistungsseite
RewriteRule ^leistungen/vampirlifting-prp/?$ https://www.schick-aesthetics.com/leistungen/homoeopathische-eigenbluttherapie/ [R=301,L]

# Direkte Aufrufe von /docs/... auf die saubere Adresse umleiten
RewriteCond %{THE_REQUEST} \s/+docs/([^\s?]*) [NC]
RewriteRule ^ https://www.schick-aesthetics.com/%1 [R=301,L,NE]

# /index.html bzw. /ordner/index.html -> /ordner/
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?] [NC]
RewriteRule ^ https://www.schick-aesthetics.com/%1 [R=301,L,NE]

# Seitenadressen ohne abschließenden Schrägstrich -> mit Schrägstrich (/preise -> /preise/)
# (gilt für alles ohne Dateiendung; Dateien wie style.css oder termine.php bleiben unberührt)
RewriteCond %{REQUEST_URI} !^/docs/
RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]{1,5}$
RewriteRule ^(.*[^/])$ https://www.schick-aesthetics.com/$1/ [R=301,L]

# http -> https und Adresse ohne "www" -> mit "www" (eine Adresse für Google)
RewriteCond %{HTTP_HOST} ^schick-aesthetics\.com$ [NC]
RewriteRule ^(.*)$ https://www.schick-aesthetics.com/$1 [R=301,L,NE]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP_HOST} ^www\.schick-aesthetics\.com$ [NC]
RewriteRule ^(.*)$ https://www.schick-aesthetics.com/$1 [R=301,L,NE]

# Alles intern aus docs/ ausliefern
RewriteCond %{REQUEST_URI} !^/docs/
RewriteRule ^(.*)$ docs/$1 [L]
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/manifest+json .webmanifest
